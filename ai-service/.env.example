# --- Backend ---
BACKEND_URL=http://127.0.0.1:3000
# BACKEND_HEALTH_URL=            # bos birakilirsa BACKEND_URL + /api/health
# BACKEND_RETRY_INTERVAL=2
# BACKEND_WAIT_TIMEOUT=0         # 0 = backend hazir olana kadar sonsuz bekle

# --- Genel ---
# LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
# SIMULATE_HARDWARE=0            # 1 = donanim yokken sahte sensor verisi (yalnizca gelistirme!)

# --- Kamera ve postur ---
# Kaynaklar sirayla denenir; baglanti koparsa bir sonrakine gecilir.
CAMERA_URL_1=http://192.168.1.100:4747/video
CAMERA_URL_2=http://10.0.0.100:4747/video
# CAMERA_CONNECT_TIMEOUT=3
# CAMERA_RECONNECT_DELAY=2
# MJPEG_HOST=0.0.0.0
# MJPEG_PORT=5001
POSTURE_THRESHOLD=0.15
# POSTURE_EVENT_INTERVAL=5
# POSTURE_ANALYSIS_FRAME_STEP=3  # her N. karede bir analiz (CPU tasarrufu)
# POSTURE_MIN_VISIBILITY=0.5     # omuz/burun gorunurluk esigi; 0 = kontrolu kapat

# --- Sensorler ---
I2C_PORT=3
BME280_ADDRESS=0x76
# SENSOR_READ_INTERVAL=15
# SENSOR_MAX_CONSECUTIVE_ERRORS=3
# SENSOR_REINIT_DELAY=10

# --- MQ135 / ADS1115 ---
# ADS1115 besleme gerilimi. MQ135 AO bunun +0.3 V'unu asarsa cip zarar gorur;
# arayuzdeki Donanim durumu karti bunu uyarir.
# ADS1115_SUPPLY_VOLTS=3.3
# MQ135_VCC_VOLTS=5.0

# --- LED ---
LED_COUNT=55
LED_PIN=18
# LED_BRIGHTNESS=128
# Seridin cekebilecegi en yuksek akim (mA). Asilirsa parlaklik otomatik kisilir;
# Pi'nin 5V hattindan beslenen kurulumlarda dusuk gerilimi onler. 0 = sinirsiz
# (serit ayri bir 5V kaynaktan besleniyorsa).
# LED_MAX_CURRENT_MA=1000

# --- NFC ---
# NFC_POLL_INTERVAL=0.5         # kisaldikca CPU artar (kart yokken her sorgu ~90 ms SPI)
# NFC_REPEAT_COOLDOWN=3          # ayni kart en son gorulmesinden bu kadar sn sonra tekrar bildirilir
