# Zenith Backend Configuration
PORT=3000

# Database
DB_PATH=./zenith.sqlite

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_CITY=Izmir
WEATHER_LANG=tr
WEATHER_UNITS=metric

# Opsiyonel
# RAW_RETENTION_HOURS=24        # ham sensör/postür verisinin saklanma süresi
# MAX_HISTORY_POINTS=100        # grafiklerde en fazla nokta sayısı
